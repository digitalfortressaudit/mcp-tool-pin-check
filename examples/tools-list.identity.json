{
  "id": 1,
  "initialize": {
    "id": 0,
    "jsonrpc": "2.0",
    "result": {
      "capabilities": {
        "tools": {
          "listChanged": false
        }
      },
      "serverInfo": {
        "name": "local-notes",
        "version": "1.0.0"
      },
      "protocolVersion": "2025-06-18"
    }
  },
  "jsonrpc": "2.0",
  "result": {
    "tools": [
      {
        "name": "get_note",
        "description": "Return one note by its identifier.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "Note identifier."
            }
          }
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false
        }
      },
      {
        "name": "list_notes",
        "description": "List notes whose titles contain a query string.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query"
          ],
          "properties": {
            "query": {
              "type": "string",
              "description": "Text to match against note titles.",
              "maxLength": 200
            }
          }
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false
        }
      }
    ]
  }
}
